# cots.env - settings of the 1-cell COTS-UE demo (Benetel RU + OAI gNB + Open5GS) on OUR green-context cuphycontroller with the YOLO dApp.
# Sourced by cots_run.sh / cots_core.sh. Everything the host side needs is in this directory; the L1 runs inside the Aerial container.
CONTAINER=c_aerial_troy                      # Aerial 25-3 container that mounts the SDK tree at /opt/nvidia/cuBB (started with cuPHY-CP/container/run_aerial.sh -d; it is --rm)
BUILD_DIR=build.aarch64_f1002                # our L1 build: SCF_FAPI_10_04 OFF, ENABLE_CONFORMANCE_TM_PDSCH_PDCCH OFF, SCF_FAPI_10_04_SRS ON, ENABLE_DAPP_HOOK ON
L1_CONFIG=dgist                              # cuphycontroller_scf <name> -> config/cuphycontroller_<name>.yaml (+ l2_adapter_<name>.yaml), copied into the container at start
PRACH_FORCE_THR0=20.0                        # researchers' PRACH detection threshold (their binary hard-codes it; ours reads CUPHY_PRACH_FORCE_THR0). Empty = cuPHY's own threshold
RU_IP=10.10.0.100                            # Benetel RU management address (ping check only)
FH_IF=aerial00                               # host interface of the Benetel fronthaul link (link-state check only)
# ---- dApp (defaults = the validated 1-cell configuration; see MANUAL.md)
DAPP_PUSCH_PROFILES=16,24,32,40,56           # per-slot PUSCH green-context profiles (-> 20/28/36/44/60 SMs); the largest replaces yaml mps_sm_pusch
DAPP_PDSCH_PROFILES=24,40                    # per-slot PDSCH profiles; the largest replaces yaml mps_sm_pdsch
DAPP_TENANT_CLASSES=24,40,48,56,64,72,80     # YOLO partition classes = the free-SM values of the 1-cell layout (P-N-8: 80 72 64 56 48 40 24; 32 never occurs); one engine per model x class (~1.7 GB GPU memory each)
DAPP_TENANT_CPU=45; DAPP_AGENT_CPU=46        # isolated cores for the tenant and the xApp agent threads (the L2A export thread uses 43, see l2_adapter yaml)
DAPP_AGENT_PORT=9810                         # xApp interface (TCP, JSON lines)
DAPP_AGENT_GRAPH_CHUNK=3; DAPP_AGENT_CHUNK_AHEAD=2; DAPP_AGENT_QOS=1
# ---- OAI gNB container (oai/docker-compose.yaml, oai/gnb.conf = the researchers' gnb_original.txt + poll core)
OAI_IMAGE=oai-gnb-aerial_hsw:hybrid-uci      # 'latest' (2026-09-03) + the empty-UCI hunk; validated with our L1 on 2026-10-30 (ue21)
OAI_CPUSET=56-62                             # off the L1 cores (yaml: 4-10) and the dApp cores (43/45/46); gnb.conf tr_s_poll_core = 62
OAI_CONTAINER=oai-gnb-dgist
# ---- Open5GS (native services of this host; cots_core.sh)
UE_SUBNET=10.45.0.0/16
