# benetel_cell.env - the few values the hybrid scripts need on top of the BASELINE files (sweep/hybrid/baseline/ = byte copies of the
# researchers' proven COTS-UE setup: cuphycontroller_config_benetal.yaml, l2_adapter_config_P5G_GH.yaml, gnb_original.txt, compose).
# Principle (2026-10-29): the hybrid L1/L2A yamls are GENERATED FROM THE BASELINE FILES; the Benetel cell block, every global key and the
# OAI gnb.conf stay as in the baseline unless listed below. Sourced by bash (hybrid_config.sh, hybrid_run.sh) and read by hybrid_yaml.py.
BASE_CUPHY=baseline/cuphycontroller_config_benetal.yaml   # relative to this directory. _uplink_heavy = the researchers' UL-centric variant (pusch_aggr 6, ul_input_buffer 16)
BASE_L2A=baseline/l2_adapter_config_P5G_GH.yaml
BENETEL_NIC=0002:01:00.0                 # aerial00 (BlueField-3 port): the baseline cell's nic; the emulator cells stay on 0000:01:00.0 (lab nics entry appended)
NCELLS_DEFAULT=9                         # emulator cells
BENETEL_CELL_INDEX=last                  # last (default) = verified full6 layout: emulator = nics[0] / L1 cells 0..N-1 (transport 0), Benetel = nics[1] / L1 cell N (transport 1,
                                         # baseline prefix 'nvipc', OAI gnb.conf unchanged). 'first' (Benetel = nics[0]/cell 0) hits cuphydriver NIC-0/cell-0 assumptions:
                                         # Debug-task nullptr (ue1) and 100 % PUSCH CRC failure on every emulator cell (ue2, 10-29) - experiments only.

# ---- L1 global keys that are NOT taken from the baseline (the only deviations; each one reported in CONFIG_MAP.md section 3)
# (b) capacity for 9+1 cells and (c) instrumentation the KPI tools parse and (d) the CPU-core plan of c_aerial_troy: values copied from the
#     lab file (cuphycontroller_F08_CG1.yaml after test_config.sh) at apply time, so they track the lab baseline.
L1_KEYS_FROM_LAB="mps_sm_pusch mps_sm_pucch mps_sm_prach mps_sm_ul_order mps_sm_pdsch mps_sm_pdcch mps_sm_pbch mps_sm_gpu_comms use_batched_memcpy dpdk_thread h2d_copy_thread_cpu_affinity workers_ul workers_dl enable_cpu_task_tracing enable_prepare_tracing pmu_metrics ul_order_timeout_gpu_log_enable ul_order_timeout_log_interval_ns"
# beam/bfw keys (bfw_* .. sendCPlane_*bfw_backoff_th_ns): the emulator cells use static beam ids (ru-emulator config oran_beam_id_info 1..16527 / 16528..32767)
# -> the L1 needs the same ranges and the BFW C-plane settings of the lab (absent in the single-cell baseline = defaults). Inert for the Benetel (no BF).
# (mps_sm_srs stays baseline 0: enable_srs 0 in both files. debug_worker stays baseline -1: with the lab's 13 the per-slot Debug task calls
#  DLOutputBuffer::waitPrePrepareStop on a nullptr for the NIC that has no DL cell in the slot -> SIGSEGV in DebugWorker13 (gdb1, 2026-10-29).)
L1_TOP_KEYS_FROM_LAB="low_priority_core"
# explicit values (key=value, top-level cuphydriver_config keys; set or appended)
L1_GLOBAL_OVERRIDES="prach_aggr_per_ctx=4"   # baseline 2: the OAI PRACH (slots 9/19) and the emulator PRACH (8/17/19) share slot 19 -> 'No available Aggr PRACH objects', Err.ind 0x33 (2026-10-26)
# everything else in cuphydriver_config = baseline: fix_beta_dl 0, ul_order_timeout_cpu_ns 4 ms, pusch_waitTimeOut* 5000, max_ru_unhealthy_ul_slots 0,
# pusch_workCancelMode absent (=0; the lab ran 2), pusch_aggr_per_ctx 3, ul_input_buffer_per_cell 10, ul_pcap_capture_enable absent (=0; the lab 1).

# ---- L2 adapter (base P5G_GH): only the thread cores (9/9 in the baseline = the lab's DL worker 9) and the research hook line from the lab file
L2A_TIMER_CORE=11
L2A_MSG_CORE=12
L2A_KEYS_FROM_LAB="dapp_hook allowed_fapi_latency staticPuschSlotNum staticPucchSlotNum staticPdcchSlotNum staticPdschSlotNum staticCsiRsSlotNum staticSsbPcid staticSsbSFN"   # top-level lines copied verbatim from the lab l2_adapter_config_F08_CG1.yaml (absent -> skipped)
# static*SlotNum 0 (lab; baseline absent = -1 = real slot numbers): the F08 test vectors are all generated for slot 0 ('_s0' files) and the lab L2A
# forces slot number 0 into every PUSCH/PUCCH/PDSCH/PDCCH/CSI-RS command so that they decode in any slot (scf_5g_slot_commands.cpp:158, :658,
# pdcch.cpp:79, pdsch_csirs.cpp:2989, scf_5g_fapi_phy.cpp:1153). With the real slot numbers every emulator PUSCH fails CRC (ue2-ue4 10-29); with slot 0
# for all cells the COTS UE cannot decode PDSCH/get its PUSCH decoded outside slot 0 (final8 10-27: RA stuck at Msg3). The keys are global in the L2A,
# so the hybrid build adds 'staticSlotCellMask' (hybrid_yaml.py writes it = the emulator cells): the static values apply only to those cells.
# enable_beam_forming / enable_precoding: lab 1/1 (baseline 0/0). The F08 emulator test vectors are beam-formed/precoded: with bf 0 the UL C-plane carries no
# beam ids, the emulator transmits the wrong UL IQ and every PUSCH fails CRC (ue2/ue3 10-29: 600/600 slots per second on all 9 cells, packets on time);
# with precoding 0 the DL IQ is wrong (invisible since payload_validation 0). The OAI cell sends beam idx 0 / PM idx 0 -> no beam/precoding (final7 10-27: UE RA with 1/1).
# allowed_fapi_latency: lab/NVIDIA 1 (baseline 0). With 0 the last cell of testMAC's per-slot burst (9 cells) arrives one tick late and is dropped:
# ue2 10-29: 98 k Err.ind (0x80/0x03, 0x83/0x06, 0x84/0x06) on that cell + 'Dropping the slot command'. OAI's single-cell messages are never late (latency 0 either way).
# baseline values kept: enableTickDynamicSfnSlot 1 (lab 0), enable_precoding/enable_beam_forming 0 (lab 1/1),
# prach_ta_offset_usec 2.5 on every instance, pcap_enable 1 (applied to the OAI transport only, see below), timer_thread_wakeup_threshold default 15000 (lab 20000).

# ---- nvIPC transports (nvipc_multi_hybrid.yaml): transport 0 = the baseline prefix for the OAI gNB (unchanged gnb.conf), transport 1 = testMAC
OAI_PREFIX=nvipc                         # gnb.conf MACRLCs.tr_s_shm_prefix (baseline value, not edited)
TESTMAC_PREFIX=nvipc1                    # test_mac_config.yaml shm_config prefix (lab file edited at apply time)
WAIT_ALL_CELL_CONFIG=1                   # no SLOT.indication until all N+1 cells are CONFIG-ed (OAI starts before testMAC; 0 + an unconfigured cell = L1 segfault)
OAI_NVIPC_PCAP=1                         # baseline P5G_GH pcap_enable 1 -> kept for the OAI transport (FAPI pcap of the real cell in /var/log/aerial/nvipc_pcap, 2 GB cap); testMAC transport 0
NVIPC_PCAP_CORE=14                       # lab core for the pcap threads (baseline 10 = the lab's DL worker 10)

# ---- RU emulator (lab config.yaml): mirror the baseline's fix_beta_dl, and with fix_beta_dl 0 switch the DL payload memcmp off
RU_PAYLOAD_VALIDATION=0                  # the TV's bfp9 bytes are compressed at beta 65536; with the computed beta (fs_offset 0) every DL slot is 'Payload Validation ERROR' (2026-10-27). DL timing validation and UL unchanged.

# ---- OAI gNB container (openairinterface5g/ci-scripts/yaml_files/sa_gnb_aerial_hybrid)
OAI_POLL_CORE=62                         # gnb.conf tr_s_poll_core: baseline 18 = testMAC's builder core (15-18) -> the only edit of gnb_original.txt
OAI_CPUSET=56-62                         # compose cpuset: baseline 13-18 overlaps L1 debug_worker 13 / pcap 14 / testMAC 15-18
OAI_TAG=hybrid-uci                       # oai-gnb-aerial_hsw:<tag>: baseline 'latest' (2026-09-03) + oai_empty_uci.patch (the hybrid L1 sends the OAI cell a
                                         # UCI.indication with 0 UCIs whenever an emulator cell has UCI on PUSCH in the same slot; unpatched OAI aborts at the first Msg3)
OAI_DIR=/home/troy/build/openairinterface5g/ci-scripts/yaml_files/sa_gnb_aerial_hybrid

# ---- L1 binary: build.aarch64_f1002 configured like the baseline build: SCF_FAPI_10_04=OFF, ENABLE_CONFORMANCE_TM_PDSCH_PDCCH=OFF, SCF_FAPI_10_04_SRS=ON
#      (hybrid_run.sh checks CMakeCache.txt). The lab build.aarch64 has CONFORMANCE_TM ON, which adds a testMode byte to DL_TTI.request: testMAC and
#      that L1 agree with each other, but OAI sends the standard layout -> its DL_TTI was misparsed (no SSB/SIB1, 'PDU count mismatch DL_TTI=0') in ue1-ue5.
#      + the researchers' PRACH change (phyprach_aggr.cpp, env-gated) + the staticSlotCellMask L2A patch.
PRACH_FORCE_THR0=20.0                    # exported as CUPHY_PRACH_FORCE_THR0 to the L1: force_thr0 = 20.0 for every PRACH occasion (baseline build: unconditional). Empty = cuPHY's computed threshold.
L1_BUILD_DIR_DEFAULT=build.aarch64_f1002

# 10-29 ue7: enable_precoding/enable_beam_forming and the L1 bfw_*/beam-id keys are NOT copied from the lab any more (baseline 0 / absent). They were
# added in ue4 as a guess for the emulator UL failure; the real cause was the static slot keys (staticSlotCellMask). Both switches are global in the
# L2A (ssb_pbch/pdsch command builders use them for every cell, the Benetel cell included) so the baseline value is the safe one for the UE.

# 2026-10-30: log_level removed from L1_KEYS_FROM_LAB (lab DBG -> baseline INFO). The DBG console/file log of the 10-cell L1 grew to ~20 GB in the
# 30-min COTS-UE run ue21 and filled the disk during teardown (restore had to be re-run). Put it back only for short KPI-tool runs.
