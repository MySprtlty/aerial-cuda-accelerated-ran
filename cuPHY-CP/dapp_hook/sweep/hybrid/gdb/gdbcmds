set pagination off
set confirm off
handle SIGUSR1 SIGUSR2 SIG34 SIG35 SIG36 SIG37 SIG38 nostop noprint pass
run
echo \n=== CRASH: backtrace of the faulting thread ===\n
bt 40
echo \n=== registers ===\n
info registers pc sp x0 x1 x2 x3
echo \n=== all threads (8 frames) ===\n
thread apply all bt 8
echo \n=== shared libraries ===\n
info sharedlibrary
quit
